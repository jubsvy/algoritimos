programa {
  funcao inicio() {
    inteiro opcao
    escreva("(0-3):")
    leia(opcao)

    escolha (opcao){
      caso 1:
      escreva("Encaminhando para vendas")
      pare
      caso 2:
      escreva("Encaminhando para Suporte Técnico")
      pare
      caso 3:
      escreva("Encaminhando para financeiro")
      pare
      caso 0:
      escreva("Encerrando chamada")
      pare

    }
  }
}
