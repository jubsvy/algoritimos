programa {
  funcao inicio() {
    cadeia nome
    inteiro pontos, idade

    nome = "julia"
    pontos = 1500
    idade = 16
    escreva("olá, mundo! \n")
    escreva(nome, " tem ", idade, " anos de idade. \n")
    escreva(nome, " tem ", idade, " anos de idade. ela trabalha muito e tirou um dia de folga para jogar basquete, ela jogou e marcou ", pontos, " pontos." )
  }
}
