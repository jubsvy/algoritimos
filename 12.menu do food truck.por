programa {
  funcao inicio() {
    inteiro opcao
    escreva("escolha(1-3):")
    leia(opcao)

    escolha (opcao){
      caso 1: 
      escreva("Hamburguer R$25")
      pare 
      caso 2:
      escreva("Batata frita R$15")
      pare
      caso 3:
      escreva("Refrigerante R$8")
      pare
      caso contrario:
      escreva("Código inválido")
    }
  }
}
